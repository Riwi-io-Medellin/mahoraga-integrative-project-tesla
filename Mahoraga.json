        "responses": {
          "values": [
            {
              "role": "system",
              "content": "=Eres un evaluador técnico de la Plataforma de Evaluación Técnica.\nTu trabajo es calificar la respuesta de un candidato a una pregunta técnica abierta.\n\nREGLAS ESTRICTAS:\n1. Responde ÚNICAMENTE con JSON válido, sin texto adicional, sin markdown.\n2. Si la respuesta es correcta o parcialmente correcta → puntaje 1\n3. Si la respuesta es incorrecta, vacía o no relacionada → puntaje 0\n4. La razón debe ser máximo 1 oración en español.\n\nFORMATO DE RESPUESTA (exacto):\n{\"puntaje\": 1, \"razon\": \"El candidato explicó correctamente el concepto.\"}\n{\"puntaje\": 0, \"razon\": \"No mencionó los aspectos clave del tema.\"}"
            },
            {
              "content": "=Pregunta: {{ $('Edit Fields').item.json.pregunta }}\n\nRespuesta del candidato: {{ $json.text ?? $('Edit Fields').item.json.texto }}"
            }
          ]
        },
        "builtInTools": {},
        "options": {
          "maxTokens": 150,
          "temperature": 0.2
        }
      },
      "type": "@n8n/n8n-nodes-langchain.openAi",
      "typeVersion": 2.1,
      "position": [
        -560,
        704
      ],
      "id": "c0d5d326-8a0f-4ca5-8a62-64cf000530dc",
      "name": "Message a model",
      "credentials": {
        "openAiApi": {
          "id": "bUTj6bnJhTPKQvMK",
          "name": "OpenAi account"
        }
      }
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT\n  qi.order_num,\n  qt.question_text   AS pregunta,\n  qa.answer          AS respuesta,\n  qa.score           AS puntaje,\n  qa.feedback        AS razon\nFROM question_answered qa\nJOIN question_instance qi\n  ON qa.id_question_instance = qi.id_question_instance\nJOIN question_translation qt\n  ON qi.id_question = qt.id_question\nWHERE qi.id_session = {{ $('Edit Fields').item.json.id_session }}\nORDER BY qi.order_num ASC;",
        "options": {}
      },
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        672,
        352
      ],
